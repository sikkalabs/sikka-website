---
import '../styles/style.css';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Absolute path of the page, e.g. "/features.html" */
  path?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Nav highlight */
  active?: 'home' | 'features' | 'run-node' | 'developers' | 'transfer';
  /** Optional page JSON-LD */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path, active, jsonLd, ...seo } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="icon" href="/sikka.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <SEO title={title} description={description} path={path} jsonLd={jsonLd} {...seo} />

    <!-- Page-specific head extensions (extra meta, CDN scripts, etc.) -->
    <slot name="head" />
  </head>
  <body>
    <Nav active={active} />
    <slot />
    <Footer />

    <script>import '../scripts/nav.js';</script>
    <script>import '../scripts/reveal.js';</script>
  </body>
</html>
