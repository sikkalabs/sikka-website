---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "SIKKA — Simple, Private, Zero-Fee Money";
const description = "SIKKA — the simplest digital currency for humans, AI agents, and machines. Zero fees, no transaction history, private by default, post-quantum ML-DSA-87. Live on mainnet.";
const path = "/";
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'SIKKA',
    url: 'https://sikkalabs.com',
    description: 'Simple, private, zero-fee digital currency for humans, AI agents, and machines. Post-quantum ML-DSA-87.',
    logo: 'https://sikkalabs.com/sikka.svg',
    sameAs: ['https://t.me/sikkalabs', 'https://x.com/sikkalabs', 'https://github.com/sikkalabs']
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'SIKKA',
    url: 'https://sikkalabs.com/'
  }
];

---
<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd} active="home">

<section class="hero">
  <div class="hero-bg">
    <canvas id="hero-canvas"></canvas>
    <div class="hero-grid-lines"></div>
  </div>

  <div class="hero-content">
    <div class="hero-badge reveal">
      <span class="dot"></span>
      Live on Mainnet
    </div>
    <h1 class="hero-title reveal reveal-delay-1">
      <span class="big gradient-text">SIKKA</span>
      <span style="display:block;font-size:clamp(1.4rem,3.5vw,2.4rem);font-weight:700;letter-spacing:-0.03em;color:var(--text-2);margin-top:0.5rem;">Simple Money for Machines &amp; Humans</span>
    </h1>
    <p class="hero-sub reveal reveal-delay-2">
      Zero fees. No transaction history. Private by default.
      Post-quantum ML-DSA-87 — built for humans, AI agents, and machines alike.
    </p>
    <div class="hero-actions reveal reveal-delay-3">
      <a href="https://1.sikkalabs.com" target="_blank" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-wallet"></i> Web Wallet
      </a>
      <a href="https://matcha.xyz/tokens/ethereum/0xbab5a2cc8c9eb4042eeae289b26b66166cf04a81?sellChain=1&sellAddress=0xdac17f958d2ee523a2206206994597c13d831ec7" target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
        <i class="fa-solid fa-mug-hot"></i> Trade on Matcha
      </a>
    </div>

    <div class="hero-socials reveal reveal-delay-4">
      <a href="https://t.me/sikkalabs" target="_blank" class="btn btn-ghost btn-lg">
        <i class="fa-brands fa-telegram"></i> Telegram
      </a>
      <a href="https://x.com/sikkalabs" target="_blank" class="btn btn-ghost btn-lg">
        <i class="fa-brands fa-x-twitter"></i> Follow on X
      </a>
      <a href="https://github.com/sikkalabs/sikka" target="_blank" class="btn btn-ghost btn-lg">
        <i class="fa-brands fa-github"></i> GitHub
      </a>
    </div>
  </div>
</section>


<div class="marquee-section">
  <div class="marquee-track" aria-hidden="true">
    
    <div class="marquee-item"><i class="fa-solid fa-bolt"></i> Zero Fees</div>
    <div class="marquee-sep">·</div>
    <div class="marquee-item highlight"><i class="fa-solid fa-lock"></i> ML-DSA-87</div>
    <div class="marquee-sep">·</div>
    <div class="marquee-item highlight"><i class="fa-solid fa-gem"></i> 19,960,907 Genesis Supply</div>
    <div class="marquee-sep">·</div>
    <div class="marquee-item"><i class="fa-solid fa-shield-halved"></i> No Transaction History</div>
    <div class="marquee-sep">·</div>
    <div class="marquee-item highlight"><i class="fa-solid fa-users"></i> Native Multisig</div>
    <div class="marquee-sep">·</div>
    <div class="marquee-item"><i class="fa-solid fa-robot"></i> AI Agent Payments</div>
    <div class="marquee-sep">·</div>
    <div class="marquee-item highlight"><i class="fa-solid fa-percent"></i> Spam Credits</div>
    <div class="marquee-sep">·</div>
    <div class="marquee-item"><i class="fa-solid fa-box"></i> 17 MB Static Binary</div>
    <div class="marquee-sep">·</div>
    <div class="marquee-item highlight"><i class="fa-solid fa-network-wired"></i> Deterministic Sync</div>
    <div class="marquee-sep">·</div>
    
    <div class="marquee-item"><i class="fa-solid fa-bolt"></i> Zero Fees</div>
    <div class="marquee-sep">·</div>
    <div class="marquee-item highlight"><i class="fa-solid fa-lock"></i> ML-DSA-87</div>
    <div class="marquee-sep">·</div>
