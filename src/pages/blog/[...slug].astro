---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} — SIKKA`;
const description = post.data.description;
const slugPath = post.id.endsWith('.html') ? post.id : post.id;
const path = `/blog/${slugPath}.html`;
const url = `https://sikkalabs.com/blog/${slugPath}.html`;
const pubDate = post.data.pubDate;
const isoDate = post.data.updatedDate ?? pubDate;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sikkalabs.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://sikkalabs.com/blog.html' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: pubDate.toISOString(),
    dateModified: isoDate.toISOString(),
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: 'SIKKA Labs', url: 'https://sikkalabs.com/' },
    publisher: { '@type': 'Organization', name: 'SIKKA Labs', url: 'https://sikkalabs.com/' },
    ...(post.data.tags.length ? { keywords: post.data.tags.join(', ') } : {}),
  },
];

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} path={`/blog/${slugPath}.html`} jsonLd={jsonLd} active="blog">

  <section class="section" style="padding-top:7rem;">
    <div class="container">
      <a class="back-link" href="/blog.html"><i class="fa-solid fa-arrow-left"></i> All posts</a>
      <article class="content-prose">
        <header class="post-hero">
          <div class="post-meta">
            <time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>
            {post.data.tags.map((tag) => <span class="tag tag-muted">{tag}</span>)}
          </div>
          <h1 style="font-size:clamp(1.8rem, 4vw, 3rem);">{post.data.title}</h1>
          <p style="font-size:1.05rem;color:var(--text-2);max-width:600px;margin:1rem auto 0;">{post.data.description}</p>
        </header>
        <div class="article-body">
          <Content />
        </div>
      </article>
    </div>
  </section>
</BaseLayout>