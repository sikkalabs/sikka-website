---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('changelog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.released.valueOf() - a.data.released.valueOf(),
);

const renderedEntries = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);

const title = 'Changelog — SIKKA';
const description =
  'Release notes for the SIKKA network — new features, improvements, fixes, and security updates as they ship.';
const path = '/changelog.html';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sikkalabs.com/' },
    { '@type': 'ListItem', position: 2, name: 'Changelog', item: 'https://sikkalabs.com/changelog.html' },
  ],
};

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>

  <section class="page-hero">
    <div class="container">
      <span class="label">Release Notes</span>
      <h1>Changelog</h1>
      <p>What ships to the SIKKA network, and when. Sorted newest first.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      {
        entries.length > 0 ? (
          <div class="changelog-list">
            {renderedEntries.map(({ entry, Content }) => (
              <article class="changelog-item">
                <div class="changelog-item-head">
                  <span class="cl-cat">{entry.data.category}</span>
                  <h2>{entry.data.version} — {entry.data.title}</h2>
                  <span class="cl-date">{fmt.format(entry.data.released)}</span>
                </div>
                <div class="cl-body"><Content /></div>
              </article>
            ))}
          </div>
        ) : (
          <p style="text-align:center;color:var(--text-3);padding:4rem 0;">No releases yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>