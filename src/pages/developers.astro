---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Developer Guide — SIKKA";
const description = "SIKKA developer guide — build with SIKKA in minutes. One HTTP JSON-RPC endpoint, ML-DSA-87 post-quantum wallets, zero-fee transfers. Copy, paste, run.";
const path = "/developers.html";
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sikkalabs.com/' },
      { '@type': 'ListItem', position: 2, name: 'Developers', item: 'https://sikkalabs.com/developers.html' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: 'SIKKA',
    codeRepository: 'https://github.com/sikkalabs/sikka',
    programmingLanguage: 'Rust',
    codeSampleType: 'codeRepository',
    url: 'https://github.com/sikkalabs/sikka',
  },
];

---
<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd} active="developers">

<section class="page-hero">
  <div class="container">
    <span class="label">Developer Guide</span>
    <h1>Build on <span class="gradient-text">SIKKA</span> in minutes</h1>
    <p>One HTTP endpoint. One JSON-RPC. Post-quantum keys and zero-fee transfers that work the first time — no gas estimates, no SDK, no configuration.</p>
    <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;margin-top:2rem;" class="reveal reveal-delay-1">
      <span class="tag blue"><i class="fa-solid fa-plug"></i> HTTP JSON-RPC</span>
      <span class="tag purple"><i class="fa-solid fa-lock"></i> ML-DSA-87</span>
      <span class="tag green"><i class="fa-solid fa-bolt"></i> Zero fees</span>
      <span class="tag"><span style="font-family:monospace;">POST /api/rpc</span></span>
    </div>
  </div>
</section>

<div class="container" style="padding-top:clamp(3rem,6vw,5rem);padding-bottom:4rem;">
  <div class="dev-layout">

    
    <aside class="dev-sidebar" id="dev-sidebar">
      <h4>On this page</h4>
      <a href="#overview">Overview</a>
      <a href="#connect">1 · Connect to a node</a>
      <a href="#account">2 · Look up an account</a>
      <a href="#wallet">3 · Create a wallet</a>
      <a href="#send">4 · Sign &amp; send</a>
      <a href="#demo">5 · Try it live</a>
    </aside>

    
    <div class="dev-body">

      
      <section class="doc" id="overview">
        <h2><span class="step-badge"><i class="fa-solid fa-book-open"></i></span> Overview</h2>
        <p class="lead">
          Everything in SIKKA is one <span class="inline-code">POST /api/rpc</span> call to any node on port
          <span class="inline-code">64552</span>. The built-in wallet, address lookup, and explorer are all written
          against this same interface — so the fastest way to learn the protocol is to read them. This guide distills
          those pages into four reusable building blocks: <strong>connect</strong>, <strong>look up</strong>,
          <strong>create keys</strong>, and <strong>send a transfer</strong>. Every example is copy-paste ready.
        </p>
        <p class="help" style="margin-top:1rem;">
          Methods you'll meet today: <span class="method-pill">chain.info</span>
          <span class="method-pill">account.get</span> <span class="method-pill">account.proof</span>
          <span class="method-pill">validator.list</span> <span class="method-pill">tx.submit</span>
        </p>
      </section>

      <hr class="divider"/>

      
      <section class="doc" id="connect">
        <h2><span class="step-badge">1</span> Connect to a node</h2>
        <p class="lead">
          Every node speaks JSON-RPC 2.0 over <span class="inline-code">HTTP POST /api/rpc</span>. Point at
          <span class="inline-code">https://1.sikkalabs.com</span> (mainnet) or your own node. That's the entire setup.
        </p>

        <div class="terminal code-block">
          <div class="terminal-bar">
            <div class="terminal-dots"><span></span><span></span><span></span></div>
            <span class="terminal-title">curl — chain.info</span>
            <button class="copy-btn" ><i class="fa-regular fa-copy"></i> Copy</button>
          </div>
          <div class="terminal-body">
            <pre id="curl-connect"><span class="cmt"># One call to see the whole network — height, supply, validators</span>
<span class="kw">curl</span> -s https://1.sikkalabs.com/api/rpc \
  -H <span class="str">'content-type: application/json'</span> \
  -d <span class="str">'&#123;
    "jsonrpc":"2.0",
    "id":1,
    "method":"chain.info",
    "params":null
  &#125;'</span></pre>
          </div>
        </div>

        <div class="result-card reveal">
          <div class="label"><i class="fa-solid fa-terminal" style="margin-right:6px;color:var(--green);"></i>Sample result</div>
          <div class="result-row"><span class="k">chain_id</span><span class="v">"sikka-mainnet-v1"</span></div>
          <div class="result-row"><span class="k">height</span><span class="v">12938421</span></div>
          <div class="result-row"><span class="k">total_supply</span><span class="v">19960907000000000000</span></div>
          <div class="result-row"><span class="k">total_bonded</span><span class="v">802113100000000000</span></div>
          <div class="result-row"><span class="k">active_validators</span><span class="v">42</span></div>
          <div class="result-row"><span class="k">peers / mempool</span><span class="v">7 / 3</span></div>
        </div>

        <p class="help" style="margin-top:0.75rem;">
          You don't need a node to start — <span class="inline-code">1.sikkalabs.com</span> accepts these calls
          over HTTPS. Run your own to get the same API on localhost and to serve your own copy of this guide's pages.
        </p>
      </section>

      <hr class="divider"/>

      
      <section class="doc" id="account">
        <h2><span class="step-badge">2</span> Look up an account</h2>
        <p class="lead">
          Addresses are <span class="inline-code">0x</span> + 64 hex characters (32 bytes), derived from an
          ML-DSA-87 public key. Fetch a balance with <span class="inline-code">account.get</span>, and cross-check it
          against the finalized state root with <span class="inline-code">account.proof</span>.
        </p>

        <div class="terminal code-block">
          <div class="terminal-bar">
            <div class="terminal-dots"><span></span><span></span><span></span></div>
            <span class="terminal-title">curl — account.get</span>
            <button class="copy-btn" ><i class="fa-regular fa-copy"></i> Copy</button>
          </div>
          <div class="terminal-body">
            <pre id="curl-account"><span class="kw">curl</span> -s https://1.sikkalabs.com/api/rpc \
  -H <span class="str">'content-type: application/json'</span> \
  -d <span class="str">'&#123;
    "jsonrpc":"2.0",
    "id":1,
    "method":"account.get",
    "params":&#123; "address":"0x…" &#125;
  &#125;'</span></pre>
          </div>
        </div>

        <div class="result-card reveal">
          <div class="label"><i class="fa-solid fa-terminal" style="margin-right:6px;color:var(--green);"></i>account.get → result</div>
          <div class="result-row"><span class="k">exists</span><span class="v">true</span></div>
          <div class="result-row"><span class="k">balance</span><span class="v">125000000000</span></div>
          <div class="result-row"><span class="k">bond</span><span class="v">null</span></div>
          <div class="result-row"><span class="k">battery_now</span><span class="v">72</span></div>
          <div class="result-row"><span class="k">nonce / next_nonce</span><span class="v">3 / 4</span></div>
        </div>

        <div class="cta-note">
          <i class="fa-solid fa-lightbulb"></i>
          <div>
            <p><strong>Amounts are integers.</strong> Balances are in <span class="inline-code">CHILLAR</span> —
            10⁹ CHILLAR = 1 SIKKA. Read them as <code style="font-family:monospace;color:var(--cyan);">BigInt</code>,
            never as floats. This is why the wallet uses <code style="font-family:monospace;color:var(--cyan);">json-bigint</code>.</p>
            <p style="margin-top:0.5rem;">Listing validators? <span class="method-pill">validator.list</span> — each entry
            reports <code style="font-family:monospace;color:var(--cyan);">bond</code>,
            <code style="font-family:monospace;color:var(--cyan);">active</code>, and slash / unbonding state.</p>
          </div>
        </div>

        <h3 style="margin-top:2rem;">Verify with a proof</h3>
        <p class="lead">
          SIKKA discards transaction history, so trust comes from a <strong>state root</strong>. Request a proof and
          compare the returned <span class="inline-code">state_root</span> to the finalized checkpoint. The account is
          either <em>included</em> (has funds) or <em>absent</em> (zero balance that round).
        </p>
        <div class="terminal code-block">
          <div class="terminal-bar">
            <div class="terminal-dots"><span></span><span></span><span></span></div>
            <span class="terminal-title">address.html — verify a proof</span>
            <button class="copy-btn" ><i class="fa-regular fa-copy"></i> Copy</button>
          </div>
          <div class="terminal-body">
            <pre id="js-proof"><span class="kw">const</span> proof = <span class="kw">await</span> rpc(<span class="str">"account.proof"</span>, &#123; address &#125;)
<span class="cmt">// The checkpoint header is flattened onto checkpoints, so state_root</span>
<span class="cmt">// lives on the checkpoint itself — not checkpoint.header.</span>
<span class="kw">const</span> height = proof.checkpoint?.height
<span class="kw">const</span> root    = String(proof.state_root || <span class="str">""</span>).toLowerCase()
<span class="kw">const</span> committed = String(proof.checkpoint?.state_root || <span class="str">""</span>).toLowerCase()

<span class="kw">if</span> (!root || !committed || root !== committed) &#123;
  <span class="kw">throw</span> <span class="kw">new</span> <span class="num">Error</span>(<span class="str">"state_root does not match the checkpoint"</span>)
&#125;
<span class="kw">const</span> status = proof.account != <span class="num">null</span>
  ? <span class="str">`included · height $&#123;height&#125;`</span>
  : <span class="str">`absent · height $&#123;height&#125;`</span></pre>
          </div>
        </div>
      </section>

      <hr class="divider"/>

      
      <section class="doc" id="wallet">
        <h2><span class="step-badge">3</span> Create a wallet</h2>
        <p class="lead">
          Keys are <strong>ML-DSA-87</strong> (NIST FIPS 204, Level 5). In the browser we use
          <span class="inline-code">@noble/post-quantum</span>. Keygen is two lines, and the private key never leaves
          the page.
        </p>

        <div class="terminal code-block">
          <div class="terminal-bar">
            <div class="terminal-dots"><span></span><span></span><span></span></div>
            <span class="terminal-title">wallet.html — keypair + address</span>
            <button class="copy-btn" ><i class="fa-regular fa-copy"></i> Copy</button>
          </div>
          <div class="terminal-body">
            <pre id="wallet-js"><span class="kw">import</span> &#123; ml_dsa87 &#125; from <span class="str">"https://esm.sh/@noble/post-quantum@0.6.1/ml-dsa.js"</span>
<span class="kw">import</span> &#123; sha3_256 &#125; from <span class="str">"https://esm.sh/@noble/hashes@2.2.0/sha3.js"</span>
<span class="kw">import</span> &#123; randomBytes &#125; from <span class="str">"https://esm.sh/@noble/post-quantum@0.6.1/utils.js"</span>

<span class="cmt">// 1. seed → keypair (secret 4896 B · public 2592 B)</span>
<span class="kw">const</span> &#123; secretKey, publicKey &#125; = ml_dsa87.keygen(randomBytes(32))

<span class="cmt">// 2. Address = sha3-256(publicKey) as 0x-hex, 32 bytes</span>
<span class="kw">const</span> hex = (b) => Array.from(b, x => x.toString(16).padStart(2, <span class="str">"0"</span>)).join(<span class="str">""</span>)
<span class="kw">const</span> address = <span class="str">"0x"</span> + hex(sha3_256(publicKey))

<span class="kw">console</span>.log(&#123; address, scheme: <span class="str">"ML-DSA-87"</span> &#125;)</pre>
          </div>
        </div>

        <div class="cta-note">
          <i class="fa-solid fa-shield-halved"></i>
          <div>
            <p><strong>Restore</strong> from a 32-byte seed, a 4896-byte private key, or a
            <span class="inline-code">sikka_key.json</span> keystore. Guard the seed — it's the only way back to your
            funds. Restore verifies that the stored <span class="inline-code">public_key</span> matches the derived key.</p>
          </div>
        </div>
      </section>

      <hr class="divider"/>

      
      <section class="doc" id="send">
        <h2><span class="step-badge">4</span> Sign &amp; send</h2>
        <p class="lead">
          A transfer is a small signed object sent via <span class="inline-code">tx.submit</span>. Signing binds the
          transaction to the node's <span class="inline-code">chain_id</span> with ML-DSA-87 context
          <span class="inline-code">SIKKA-v1</span>. The recipient receives the exact amount — no fee is ever deducted.
        </p>

        <p class="help">Wire format — <code style="font-family:monospace;color:var(--cyan);">signingBytes</code> from wallet.html:</p>
        <div class="terminal" style="margin:0.5rem 0 1rem;">
          <div class="terminal-body">
            <pre><span class="cmt"># tag "SIKKA/tx/v3" · str(chain_id) · kind · from · to ·
# amount · nonce · timestamp · public_key
# str(x) = u32le(byte_len) + utf8(x); amount/nonce/ts are u64le</span></pre>
          </div>
        </div>

        <div class="terminal code-block">
          <div class="terminal-bar">
            <div class="terminal-dots"><span></span><span></span><span></span></div>
            <span class="terminal-title">JS — sign a transfer (from wallet.html)</span>
            <button class="copy-btn" ><i class="fa-regular fa-copy"></i> Copy</button>
          </div>
          <div class="terminal-body">
            <pre id="send-js"><span class="kw">const</span> msg = concat(
  TX_SIGNING_TAG,                 <span class="cmt">// "SIKKA/tx/v3"</span>
  encodeStr(chainId),             <span class="cmt">// bind to this network</span>
  Uint8Array.of(<span class="num">0</span>),             <span class="cmt">// kind = transfer</span>
  from, to,                       <span class="cmt">// 32 raw bytes each</span>
  u64le(amountChillar),           <span class="cmt">// amount in CHILLAR</span>
  u64le(nonce), u64le(now),
  publicKey,
)
<span class="kw">const</span> signature = ml_dsa87.sign(msg, secretKey, &#123; context: SIGNING_CONTEXT &#125;)

<span class="kw">const</span> tx = &#123;
  <span class="str">kind</span>: <span class="str">"transfer"</span>,
  <span class="str">from</span>: myAddress, <span class="str">to</span>: toAddr,
  <span class="str">amount</span>: amount, <span class="str">nonce</span>, <span class="str">chain_id</span>: chainId,
  <span class="str">public_key</span>: <span class="str">"0x"</span> + toHex(publicKey),
  <span class="str">signature</span>: toHex(signature),
&#125;</pre>
          </div>
        </div>

        <div class="terminal code-block">
          <div class="terminal-bar">
            <div class="terminal-dots"><span></span><span></span><span></span></div>
            <span class="terminal-title">curl — tx.submit</span>
            <button class="copy-btn" ><i class="fa-regular fa-copy"></i> Copy</button>
          </div>
          <div class="terminal-body">
            <pre id="curl-tx"><span class="kw">curl</span> -s https://1.sikkalabs.com/api/rpc \
  -H <span class="str">'content-type: application/json'</span> \
  -d <span class="str">'&#123;
    "jsonrpc":"2.0","id":1,"method":"tx.submit",
    "params":&#123; "transaction": &#123; …signedTx &#125; &#125;
  &#125;'</span>
<span class="cmt"># → &#123; "result": &#123; "accepted": true, "id": "…" &#125; &#125;</span></pre>
          </div>
        </div>
      </section>

      <hr class="divider"/>

      
      <section class="doc" id="demo">
        <h2><span class="step-badge">5</span> Try it live</h2>
        <p class="lead">
          Everything above is already running. The public app pages are built from the exact same calls in this guide —
          open them, click around, and watch the network respond in real time.
        </p>

        <div class="node-features-grid reveal">
          <div class="node-feature-card">
            <div class="node-feature-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
            <div class="node-feature-title">Create &amp; send</div>
            <div class="node-feature-desc">Generate an ML-DSA-87 keypair, restore from seed, and submit a transfer — all client-side.</div>
            <a href="https://1.sikkalabs.com" target="_blank" style="font-size:0.8rem;color:var(--blue-2);font-weight:600;margin-top:8px;">Open the wallet <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
          </div>
          <div class="node-feature-card reveal reveal-delay-1">
            <div class="node-feature-icon" style="background:rgba(139,92,246,0.1);border-color:rgba(139,92,246,0.2);color:var(--purple-2);"><i class="fa-solid fa-magnifying-glass"></i></div>
            <div class="node-feature-title">Look up &amp; prove</div>
            <div class="node-feature-desc">Query anyone's balance, bond, and battery, then request a state-root proof — the same page as section 2.</div>
            <a href="https://1.sikkalabs.com/address.html" target="_blank" style="font-size:0.8rem;color:var(--blue-2);font-weight:600;margin-top:auto;">Open address lookup <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
          </div>
        </div>
      </section>

    </div>
  </div>
</div>


  <script>import '../scripts/developers.js';</script>
</BaseLayout>
