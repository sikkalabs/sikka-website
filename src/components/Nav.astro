---
interface Props {
  /** Current page slug — matches the `key` of the active nav item */
  active?: 'home' | 'features' | 'run-node' | 'developers' | 'transfer' | 'blog';
}

const { active } = Astro.props;

const NAV_ITEMS = [
  { key: 'home', label: 'Home', href: 'index.html' },
  { key: 'features', label: 'Features', href: 'features.html' },
  { key: 'run-node', label: 'Run a Node', href: 'run-node.html' },
  { key: 'developers', label: 'Developers', href: 'developers.html' },
  { key: 'transfer', label: 'Bridge', href: 'transfer.html' },
  { key: 'blog', label: 'Blog', href: 'blog.html' },
] as const;
---

<nav class="nav" id="main-nav">
  <a href="index.html" class="nav-logo" aria-label="SIKKA — home">
    <img src="/sikka.svg" alt="SIKKA logo" width="32" height="32" />
    <span>SIKKA</span>
  </a>
  <ul class="nav-links">
    {
      NAV_ITEMS.map((item) => (
        <li>
          <a href={item.href} class:list={{ active: active === item.key }}>{item.label}</a>
        </li>
      ))
    }
  </ul>
  <button
    class="nav-hamburger"
    id="hamburger"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="nav-mobile"
  >
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="nav-mobile" id="nav-mobile">
  {
    NAV_ITEMS.map((item) => (
      <a href={item.href} class:list={{ active: active === item.key }}>{item.label}</a>
    ))
  }
</div>
