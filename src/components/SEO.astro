---
/**
 * SEO — per-page head metadata.
 * Every page passes its own title/description/image; the layout renders
 * standard, Open Graph, and Twitter tags plus a canonical URL.
 */
interface Props {
  title: string;
  description: string;
  /** Absolute path of the page, e.g. "/features.html" */
  path?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** JSON-LD structured data rendered as a <script type="application/ld+json"> */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = '/',
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og.jpg',
  ogImageAlt = 'SIKKA — Simple, Private, Zero-Fee Money',
  jsonLd,
} = Astro.props;

const site = 'https://sikkalabs.com';
const url = `${site}${path}`;
const image = ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`;
const customBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Site-level structured data injected on every page so rich results always
// carry our brand (logo + social profiles) regardless of page-specific blocks.
const siteOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'SIKKA',
  url: site,
  description:
    'Simple, private, zero-fee digital currency for humans, AI agents, and machines. Post-quantum ML-DSA-87. Live on mainnet.',
  logo: `${site}/sikka.svg`,
  sameAs: [
    'https://github.com/sikkalabs',
    'https://x.com/sikkalabs',
    'https://t.me/sikkalabs',
  ],
};
const siteWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  name: 'SIKKA',
  url: `${site}/`,
  publisher: { '@id': `${site}/#organization` },
};

const jsonLdBlocks = [siteOrg, siteWebSite, ...customBlocks];
---

<meta name="description" content={description} />
<link rel="canonical" href={url} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="SIKKA" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1376" />
<meta property="og:image:height" content="752" />
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@sikkalabs" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={image} />

{jsonLdBlocks.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
